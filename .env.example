# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Redis (Upstash)
REDIS_URL="rediss://default:password@host:6379"

# Sentry (optional)
SENTRY_DSN=""

# Market Configuration
MARKET="US"

# Rate Limiting
MAX_REQUESTS_PER_DAY=500
CONCURRENT_REQUESTS=2

# Scraping Settings
HEADLESS=true
TIMEOUT_MS=30000
